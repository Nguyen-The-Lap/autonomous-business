# Public browser identifier. Supabase's anon/publishable key is safe to expose;
# access is protected by Auth and the row-level security policies in the migration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional, used to construct trusted auth callback URLs in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# No service-role key is used by this application.

# Optional, one-time legacy import only. Set these in a local shell, never in
# the deployed app environment or a NEXT_PUBLIC_* variable.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
